# Production (Vercel): Postgres connection string from Neon
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Production: bearer token required for blog write API calls
# (POST /api/posts, PUT/DELETE /api/posts/:id). Reads stay public.
# Leave unset in local development to allow writes without a token.
ADMIN_TOKEN=change-me-to-a-long-random-string
